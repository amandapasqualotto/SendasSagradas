rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() { return request.auth != null; }
    function ehAdmin() { return logado() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }

    // Plano de leitura (com o texto bíblico) — só leitura; quem grava é o script de importação
    match /dias/{id} { allow read: if logado(); }

    // Estudos e significados gerados pela IA — gravados apenas pelo servidor (/api/estudo, /api/significado)
    match /estudos/{id} { allow read: if logado(); }
    match /significados/{id} { allow read: if logado(); }
    match /relatorios/{id} { allow read: if logado(); }
    // fontes_expositor e fontes_panorama (materiais de apoio) não têm regra: só o servidor acessa

    // Lista de administradores (criada à mão no console) — podem apagar posts do mural
    match /admins/{uid} { allow read: if logado() && request.auth.uid == uid; }

    // Perfil do usuário: nome, preferências de lembrete, dia atual
    match /usuarios/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      // o e-mail gravado precisa ser o da própria conta (evita mandar lembrete para terceiros)
      allow write: if logado() && request.auth.uid == uid
        && (!('email' in request.resource.data) || request.resource.data.email == request.auth.token.email);
      match /{document=**} { allow read, write: if logado() && request.auth.uid == uid; }
    }

    // Mural da comunidade
    match /mural/{id} {
      allow read: if logado();
      allow create: if logado()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'tipo', 'texto', 'referencia', 'dia', 'amens', 'criadoEm'])
        && request.resource.data.tipo in ['versiculo', 'palavra', 'oracao', 'testemunho']
        && request.resource.data.texto is string && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 1000
        && request.resource.data.nome is string && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 60
        && request.resource.data.referencia is string && request.resource.data.referencia.size() <= 100
        && request.resource.data.amens == []
        && request.resource.data.criadoEm == request.time;
      // "Amém": qualquer pessoa logada só pode incluir/retirar o PRÓPRIO uid da lista
      allow update: if logado()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amens'])
        && request.resource.data.amens.toSet().difference(resource.data.amens.toSet()).hasOnly([request.auth.uid])
        && resource.data.amens.toSet().difference(request.resource.data.amens.toSet()).hasOnly([request.auth.uid]);
      allow delete: if logado() && (resource.data.uid == request.auth.uid || ehAdmin());
    }
  }
}
