{
  "name": "Sendas Sagradas - Lembrete diário",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [ { "field": "hours", "hoursInterval": 1, "triggerAtMinute": 0 } ] }
      },
      "id": "a1f0c6e2-0001-4b7e-9a10-000000000001",
      "name": "A cada hora",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "url": "https://sendassagradas.vercel.app/api/lembretes",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [ { "name": "x-lembrete-secret", "value": "COLE_AQUI_O_MESMO_LEMBRETES_SECRET_DA_VERCEL" } ]
        },
        "options": {}
      },
      "id": "a1f0c6e2-0002-4b7e-9a10-000000000002",
      "name": "Buscar quem lembrar",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": { "fieldToSplitOut": "lembretes", "options": {} },
      "id": "a1f0c6e2-0003-4b7e-9a10-000000000003",
      "name": "Um item por pessoa",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [480, 0]
    },
    {
      "parameters": {
        "sendTo": "={{ $json.email }}",
        "subject": "={{ $json.assunto }}",
        "emailType": "html",
        "message": "={{ $json.html }}",
        "options": { "appendAttribution": false }
      },
      "id": "a1f0c6e2-0004-4b7e-9a10-000000000004",
      "name": "Enviar e-mail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [720, 0]
    }
  ],
  "connections": {
    "A cada hora": { "main": [ [ { "node": "Buscar quem lembrar", "type": "main", "index": 0 } ] ] },
    "Buscar quem lembrar": { "main": [ [ { "node": "Um item por pessoa", "type": "main", "index": 0 } ] ] },
    "Um item por pessoa": { "main": [ [ { "node": "Enviar e-mail", "type": "main", "index": 0 } ] ] }
  },
  "settings": { "executionOrder": "v1", "timezone": "America/Sao_Paulo" },
  "pinData": {}
}
